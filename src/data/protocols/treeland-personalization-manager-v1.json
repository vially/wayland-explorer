    {
      "type": "interface",
      "name": "treeland_personalization_window_context_v1",
      "version": "1",
      "description": {
        "type": "description",
        "text": "This interface allows a client to customize per-window visual properties\nincluding background blend mode, round corner radius, shadow, border,\nand titlebar visibility.",
        "summary": "per-window personalization context"
      },
      "requests": [
        {
          "type": "request",
          "name": "set_blend_mode",
          "description": {
            "type": "description",
            "text": "Set window background blend mode",
            "summary": "set window background blend mode"
          },
          "args": [
            {
              "type": "arg",
              "name": "mode",
              "argType": "int",
              "summary": "the blend mode to apply",
              "enum": "blend_mode"
            }
          ]
        },
        {
          "type": "request",
          "name": "set_round_corner_radius",
          "description": {
            "type": "description",
            "text": "This request will set window round corner radius, invoking this request means user\nwant to\nmanage window round corner radius by itself. If not invoked, window round corner\nradius will\nbe decided by compositor.",
            "summary": "set window round corner radius"
          },
          "args": [
            {
              "type": "arg",
              "name": "radius",
              "argType": "int",
              "summary": "window round corner radius in pixels"
            }
          ]
        },
        {
          "type": "request",
          "name": "set_shadow",
          "description": {
            "type": "description",
            "text": "Set window shadow's radius, offset and color.\nWhen enabled, the client manages the window shadow itself.\n- radius = -1: enable shadow with system default parameters\n- radius =  0: disable shadow completely\n- radius >  0: enable shadow with custom parameters\nIf not invoked, the compositor uses its default behavior.",
            "summary": "set window shadow"
          },
          "args": [
            {
              "type": "arg",
              "name": "radius",
              "argType": "int",
              "summary": "shadow radius, -1 for system default, 0 to disable"
            },
            {
              "type": "arg",
              "name": "offset_x",
              "argType": "int",
              "summary": "shadow x offset"
            },
            {
              "type": "arg",
              "name": "offset_y",
              "argType": "int",
              "summary": "shadow y offset"
            },
            {
              "type": "arg",
              "name": "r",
              "argType": "int",
              "summary": "shadow color red component (0-255)"
            },
            {
              "type": "arg",
              "name": "g",
              "argType": "int",
              "summary": "shadow color green component (0-255)"
            },
            {
              "type": "arg",
              "name": "b",
              "argType": "int",
              "summary": "shadow color blue component (0-255)"
            },
            {
              "type": "arg",
              "name": "a",
              "argType": "int",
              "summary": "shadow color alpha component (0-255)"
            }
          ]
        },
        {
          "type": "request",
          "name": "set_border",
          "description": {
            "type": "description",
            "text": "Set window border width and color.\nWhen enabled, the client manages the window border itself.\n- width = -1: enable border with system default parameters\n- width =  0: disable border completely\n- width >  0: enable border with custom parameters\nIf not invoked, the compositor uses its default behavior.",
            "summary": "set window border"
          },
          "args": [
            {
              "type": "arg",
              "name": "width",
              "argType": "int",
              "summary": "border width in pixels, -1 for system default, 0 to disable"
            },
            {
              "type": "arg",
              "name": "r",
              "argType": "int",
              "summary": "border color red component (0-255)"
            },
            {
              "type": "arg",
              "name": "g",
              "argType": "int",
              "summary": "border color green component (0-255)"
            },
            {
              "type": "arg",
              "name": "b",
              "argType": "int",
              "summary": "border color blue component (0-255)"
            },
            {
              "type": "arg",
              "name": "a",
              "argType": "int",
              "summary": "border color alpha component (0-255)"
            }
          ]
        },
        {
          "type": "request",
          "name": "set_titlebar",
          "description": {
            "type": "description",
            "text": "Set system titlebar state.\n- mode = enable: force show the system titlebar\n- mode = disable: force hide the system titlebar\nOnce set, the compositor will not use its own default behavior\nfor the titlebar.\nIf not invoked, the compositor uses its default behavior.",
            "summary": "set if system titlebar is enabled"
          },
          "args": [
            {
              "type": "arg",
              "name": "mode",
              "argType": "int",
              "summary": "the titlebar enable mode",
              "enum": "enable_mode"
            }
          ]
        },
        {
          "type": "request",
          "name": "destroy",
          "requestType": "destructor",
          "description": {
            "type": "description",
            "text": "Destroy the context object.",
            "summary": "destroy the context object"
          },
          "args": []
        }
      ],
      "events": [],
      "enums": [
        {
          "type": "enum",
          "name": "blend_mode",
          "bitfield": false,
          "description": {
            "type": "description",
            "text": "Window blend mode defines how compositor composite window's surface over other\nsurfaces.",
            "summary": "window blend mode"
          },
          "entries": [
            {
              "type": "entry",
              "name": "transparent",
              "value": "0",
              "summary": "Normal blend mode, just composite over background with alpha channel"
            },
            {
              "type": "entry",
              "name": "wallpaper",
              "value": "1",
              "summary": "Composite window over wallpaper"
            },
            {
              "type": "entry",
              "name": "blur",
              "value": "2",
              "summary": "Blur the content of the window background"
            }
          ]
        },
        {
          "type": "enum",
          "name": "enable_mode",
          "bitfield": false,
          "description": {
            "type": "description",
            "text": "Set window enable mode",
            "summary": "window enable mode"
          },
          "entries": [
            {
              "type": "entry",
              "name": "enable",
              "value": "0",
              "summary": "force enable titlebar"
            },
            {
              "type": "entry",
              "name": "disable",
              "value": "1",
              "summary": "force disable titlebar"
            }
          ]
        }
      ]
    },
